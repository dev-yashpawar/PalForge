# Local development (Ollama)
GEMMA_PROVIDER=ollama
GEMMA_MODEL=gemma3:4b
OLLAMA_URL=http://127.0.0.1:11434

# Render / Google AI Studio: change the two values above to:
# GEMMA_PROVIDER=google
# GEMMA_MODEL=gemma-4-26b-a4b-it
# Then add your Google AI Studio API key below. Never commit real keys.
GEMMA_API_KEY=

# Optional credentials for a protected remote Ollama server
OLLAMA_API_KEY=

PORT=3001
HOST=127.0.0.1
MONGODB_URI=
